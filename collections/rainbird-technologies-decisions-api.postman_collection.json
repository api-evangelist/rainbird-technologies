        {
          "id": "4fc24f12-70b7-46a5-b342-caa3151844ab",
          "name": "Query - Query a running session",
          "request": {
            "name": "Query - Query a running session",
            "description": {
              "content": "A query is the method to get decisions from your knowledge map. You query a relationship in the knowledge map and provide either the subject, the object or both. More information can be found [here](https://docs.rainbird.ai/rainbird/developer-guides/api-guide/example-api-request-flow#query).",
              "type": "text/plain"
            },
            "url": {
              "path": [
                ":sessionID",
                "query"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "sessionID",
                  "description": "(Required) The session to query against"
                }
