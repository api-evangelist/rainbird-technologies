                      "value": "<boolean>"
                    },
                    {
                      "key": "version",
                      "value": "<integer>"
                    }
                  ],
                  "variable": [
                    {
                      "disabled": false,
                      "type": "any",
                      "value": "<string>",
                      "key": "kmID",
                      "description": "(Required) The knowledge map ID to start a session against"
                    }
                  ]
